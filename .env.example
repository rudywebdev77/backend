PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE=10485760
MAX_OCR_PAGES=20

# Conversion Engine Configuration ('auto' | 'adobe' | 'libreoffice' | 'local')
CONVERSION_ENGINE=auto

# Adobe PDF Services API Credentials (Get free credentials from https://developer.adobe.com/console)
PDF_SERVICES_CLIENT_ID=your_adobe_client_id_here
PDF_SERVICES_CLIENT_SECRET=your_adobe_client_secret_here
